{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benefitflow/economics-event/v1",
  "title": "BenefitFlow Economics Event v1 (Research Draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "occurred_at",
    "journey_id",
    "activity_id",
    "event_type",
    "workflow_stage",
    "outcome",
    "wall_clock_ms",
    "active_human_ms",
    "automated_compute_ms",
    "api_call_count",
    "data_lookup_count",
    "voice_seconds",
    "sms_segments",
    "email_messages",
    "retry_count",
    "reconciliation_count",
    "synthetic"
  ],
  "properties": {
    "schema": {
      "const": "benefitflow/economics-event/v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 8
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "journey_id": {
      "type": "string",
      "minLength": 8
    },
    "activity_id": {
      "type": "string",
      "minLength": 8
    },
    "booking_intent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PLAN_PARSE_STARTED",
        "PLAN_PARSE_SUCCEEDED",
        "PLAN_PARSE_FAILED",
        "PLAN_PARSE_MANUAL_REVIEW_REQUIRED",
        "PLAN_MODEL_BUILT",
        "PLAN_OPTIMIZATION_STARTED",
        "PLAN_OPTIMIZATION_SUCCEEDED",
        "PLAN_OPTIMIZATION_FAILED",
        "PROVIDER_SEARCH_STARTED",
        "PROVIDER_CANDIDATE_FOUND",
        "PROVIDER_CANDIDATE_REJECTED",
        "PROVIDER_ENRICHMENT_REQUESTED",
        "PROVIDER_ENRICHMENT_COMPLETED",
        "PROVIDER_VERIFICATION_STARTED",
        "PROVIDER_VERIFICATION_SUCCEEDED",
        "PROVIDER_VERIFICATION_INCONCLUSIVE",
        "PROVIDER_VERIFICATION_FAILED",
        "AVAILABILITY_OBSERVED",
        "AVAILABILITY_STALE",
        "AVAILABILITY_REFRESHED",
        "BOOKING_PROPOSAL_CREATED",
        "BOOKING_PROPOSAL_PRESENTED",
        "BOOKING_PROPOSAL_APPROVED",
        "BOOKING_PROPOSAL_DECLINED",
        "BOOKING_PROPOSAL_EXPIRED",
        "FRESH_APPROVAL_REQUIRED",
        "TRANSACTION_ATTEMPT_STARTED",
        "HOSTED_HANDOFF_OPENED",
        "APPOINTMENT_REQUEST_SUBMITTED",
        "PHONE_CALL_STARTED",
        "PHONE_CALL_ENDED",
        "EMAIL_REQUEST_SENT",
        "WAITLIST_JOINED",
        "SLOT_HELD",
        "BOOKING_CONFIRMED",
        "TRANSACTION_FAILED",
        "TRANSACTION_AMBIGUOUS",
        "HUMAN_RECOVERY_STARTED",
        "HUMAN_RECOVERY_COMPLETED",
        "CANCELLATION_REQUESTED",
        "CANCELLATION_CONFIRMED",
        "RESCHEDULE_REQUESTED",
        "RESCHEDULE_CONFIRMED",
        "POST_BOOKING_SUPPORT_CONTACT",
        "APPOINTMENT_COMPLETION_REPORTED"
      ]
    },
    "workflow_stage": {
      "type": "string",
      "enum": [
        "PLAN_NORMALIZATION",
        "PLAN_OPTIMIZATION",
        "PROVIDER_RESEARCH",
        "PROVIDER_VERIFICATION",
        "PROPOSAL",
        "APPROVAL",
        "TRANSACTION",
        "RECONCILIATION",
        "POST_BOOKING",
        "SUPPORT"
      ]
    },
    "booking_channel_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "FIRST_PARTY_TRANSACTION_API",
        "RESTRICTED_PARTNER_API",
        "HOSTED_BOOKING_PAGE",
        "AGGREGATOR_BOOK_NOW",
        "APPOINTMENT_REQUEST_FORM",
        "PHONE",
        "EMAIL_OR_MESSAGE",
        "WAITLIST",
        "UNSUPPORTED_OR_UNKNOWN"
      ]
    },
    "external_system_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "PRACTICE_MANAGEMENT_SYSTEM",
        "INSURER_OR_ECLAIMS_RAIL",
        "PROVIDER_DIRECTORY",
        "REGULATOR_REGISTRY",
        "MAPS_OR_PLACES_DATA",
        "TELEPHONY_PROVIDER",
        "MESSAGING_PROVIDER",
        "MANUAL_CLINIC_CONTACT",
        "UNKNOWN"
      ]
    },
    "provider_candidate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "STARTED",
        "SUCCEEDED",
        "FAILED",
        "INCONCLUSIVE",
        "DECLINED",
        "AMBIGUOUS",
        "ABANDONED",
        "OBSERVED",
        "CONFIRMED"
      ]
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "wall_clock_ms": {
      "type": "integer",
      "minimum": 0
    },
    "active_human_ms": {
      "type": "integer",
      "minimum": 0
    },
    "automated_compute_ms": {
      "type": "integer",
      "minimum": 0
    },
    "human_research_ms": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "human_verification_ms": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "human_booking_ms": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "human_reconciliation_ms": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "human_support_ms": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "api_call_count": {
      "type": "integer",
      "minimum": 0
    },
    "data_lookup_count": {
      "type": "integer",
      "minimum": 0
    },
    "voice_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "sms_segments": {
      "type": "integer",
      "minimum": 0
    },
    "email_messages": {
      "type": "integer",
      "minimum": 0
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0
    },
    "reconciliation_count": {
      "type": "integer",
      "minimum": 0
    },
    "cost": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "currency",
        "amount_micros",
        "cost_type",
        "pricing_source",
        "price_version_observed_at"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "amount_micros": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_type": {
          "type": "string",
          "enum": [
            "VOICE",
            "SMS",
            "PLACE_DATA",
            "MODEL",
            "PARTNER_FEE",
            "OTHER"
          ]
        },
        "pricing_source": {
          "type": "string",
          "enum": [
            "list",
            "contract",
            "estimated",
            "unknown"
          ]
        },
        "price_version_observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "synthetic": {
      "type": "boolean"
    }
  }
}
