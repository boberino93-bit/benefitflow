{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benefitflow/agentbus-message/v2",
  "type": "object",
  "required": ["schema","protocol_version","message_id","correlation_id","idempotency_key","sender","destination","task","message_type","sequence","created_at","priority","capabilities_required","artifact_refs","payload","integrity"],
  "properties": {
    "schema": {"const": "benefitflow/agentbus-message/v2"},
    "protocol_version": {"const": "2.0.0-alpha.1"},
    "message_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string","null"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "sender": {"type": "object", "required": ["project_id","agent_id","agent_instance_id","role"]},
    "destination": {"type": "object", "required": ["project_id","agent_id","channel"]},
    "task": {"type": "object", "required": ["project_id","task_id","parent_task_id"]},
    "message_type": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string"},
    "expires_at": {"type": ["string","null"]},
    "priority": {"enum": ["normal","high","critical"]},
    "capabilities_required": {"type": "array", "items": {"type": "string"}},
    "artifact_refs": {"type": "array"},
    "payload": {},
    "integrity": {"type": "object", "required": ["payload_hash"]}
  }
}
