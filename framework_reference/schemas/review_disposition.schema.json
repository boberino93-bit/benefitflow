{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "disposition": {
      "enum": [
        "READY_FOR_INTEGRATION",
        "NEEDS_MORE_EVIDENCE",
        "REJECTED",
        "SUPERSEDED",
